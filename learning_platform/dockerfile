FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Dépendances
COPY learning_platform/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && pip install --no-cache-dir "gunicorn>=21.2"

# Code (inclut learning_platform/models/*)
COPY learning_platform/ /app/learning_platform/

# Le package est importable
ENV PYTHONPATH=/app

# Démarre l'API Flask définie dans learning_platform/app.py → objet "app"
CMD ["gunicorn","-w","2","-k","gthread","-b","0.0.0.0:5000","learning_platform.app:app"]
